{
  "name": "kinetic-migrate",
  "version": "0.1.0",
  "private": true,
  "description": "Explore, compare and promote Kinetic Platform configuration between environments.",
  "type": "module",
  "bin": {
    "kinetic-migrate": "./kinetic-migrate.mjs"
  },
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "test": "node --test lib/sync/*.test.mjs lib/sync/artifacts/*.test.mjs",
    "test:app": "vitest run && node --import tsx --test \"app/server/**/*.test.ts\"",
    "dev": "tsx watch app/server/main.ts --dev",
    "build": "vite build --config app/web/vite.config.ts && esbuild app/server/main.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/server.mjs",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.29",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^4.1.11"
  }
}
