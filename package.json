{
  "name": "kinetic-migrate",
  "version": "0.1.0",
  "private": true,
  "description": "Kinetic Migrator: a local web app and command line that explores, compares and promotes Kinetic Platform configuration between environments.",
  "license": "MIT",
  "author": "James Davies <james.davies@kineticdata.com>",
  "homepage": "https://github.com/kineticdata/kinetic-migrator-tool#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kineticdata/kinetic-migrator-tool.git"
  },
  "bugs": {
    "url": "https://github.com/kineticdata/kinetic-migrator-tool/issues"
  },
  "type": "module",
  "bin": {
    "kinetic-migrate": "./kinetic-migrate.mjs"
  },
  "files": [
    "kinetic-migrate.mjs",
    "lib/sync/**/*.mjs",
    "!lib/sync/**/*.test.mjs",
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/USER-GUIDE.md",
    "docs/CONCEPTS.md",
    "docs/CLI.md",
    "docs/PROMOTING.md",
    "docs/TROUBLESHOOTING.md",
    "docs/WALKTHROUGH.md",
    "docs/images/walkthrough/"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "test": "node scripts/run-tests.mjs lib/sync .test.mjs",
    "test:app": "vitest run && node scripts/run-tests.mjs --import tsx app/server .test.ts",
    "test:e2e": "npm run build && playwright test",
    "dev": "vite --config app/web/vite.config.ts",
    "dev:server": "tsx watch app/server/main.ts --dev",
    "build": "vite build --config app/web/vite.config.ts && node scripts/build-server.mjs",
    "start": "node kinetic-migrate.mjs ui",
    "start:fake": "node kinetic-migrate.mjs ui --fake",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc -b",
    "docs:screenshots": "npm run build && playwright test --config e2e/walkthrough/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-toast": "^1.2.24",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-virtual": "^3.14.13",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "isomorphic-git": "^1.43.1",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.52.0",
    "postcss": "^8.5.29",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^4.1.11"
  }
}
